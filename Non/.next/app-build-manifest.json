    ],
    "/(main)/dashboard/teacher/lessons/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(main)/dashboard/teacher/lessons/page.js"
    ],
    "/api/lessons/route": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/api/lessons/route.js"
    ]
  }
}