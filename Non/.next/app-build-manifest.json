      "static/css/app/(main)/lessons/[id]/page.css",
      "static/chunks/app/(main)/lessons/[id]/page.js"
    ],
    "/icon/route": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/icon/route.js"
    ],
    "/api/auth/[...nextauth]/route": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/api/auth/[...nextauth]/route.js"
    ],
    "/api/lessons/[id]/route": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/api/lessons/[id]/route.js"
    ],
